{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="narrow">
        <div class="card">
            <h1>Connexion</h1>
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form class="form" method="post">
                <div>
                    <label for="username">Email</label>
                    <input type="email" id="username" name="_username" value="{{last_username}}" autocomplete="email" required autofocus>
                </div>

                <div>
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="_password" autocomplete="current-password" required>
                </div>

                <button type="submit">Se connecter</button>
            </form>

            <p class="form-footer">Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a></p>
        </div>
    </div>
{% endblock %}
