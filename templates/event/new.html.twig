{% extends 'base.html.twig' %}

{% block title %}Ajouter un événement{% endblock %}

{% block body %}
    <div class="narrow">
        <a class="back-link" href="{{ path('app_home') }}">← Retour aux événements</a>

        <div class="card">
            <h1>Ajouter un événement</h1>
            <p class="muted">Votre événement sera visible après validation par un administrateur.</p>
            {{ form_errors(EventForm) }}
            {{ form_start(EventForm, { 'attr': { 'class': 'form' } }) }}
                {{ form_row(EventForm.titre) }}
                {{ form_row(EventForm.date) }}
                {{ form_row(EventForm.infos) }}
                {{ form_row(EventForm.categorie) }}
                {{ form_row(EventForm.nbrplaces) }}
                {{ form_row(EventForm.image) }}
            {# <form class="form" method="post" enctype="multipart/form-data">
                <div>
                    <label for="event_title" class="required">Titre</label>
                    <input type="text" id="event_title" name="event[title]" placeholder="Ex. : Soirée jazz au Kiosque" required>
                </div>

                <div>
                    <label for="event_date" class="required">Date</label>
                    <input type="datetime-local" id="event_date" name="event[date]" required>
                </div>

